DATABASE_URL=sqlite:./keyserver.db
KEYSERVER_BASE_URL=https://keys.example.com
KEYSERVER_BIND=0.0.0.0:8443
KEYSERVER_TLS_CERT=/etc/ssl/keyserver.crt
KEYSERVER_TLS_KEY=/etc/ssl/keyserver.key
KEYSERVER_SMTP_HOST=smtp.example.com
KEYSERVER_SMTP_PORT=587
KEYSERVER_SMTP_USER=keyserver@example.com
KEYSERVER_SMTP_PASSWORD=secret
KEYSERVER_SMTP_FROM=keyserver@example.com
KEYSERVER_RATE_LIMIT_SUBMISSIONS=5
# Per-IP hourly GET limit (search/detail/index). Set to 0 to disable.
KEYSERVER_RATE_LIMIT_READS=1200
# Global hourly POST submit/revoke cap (default 300 when unset). Set to 0 to disable.
# Botnets bypass per-IP limits; this caps cluster-wide registration spam. For deployments
# where open spam is unacceptable, prefer KEYSERVER_MUTATION_AUTH_SECRET (closed registry).
# KEYSERVER_RATE_LIMIT_SUBMISSIONS_GLOBAL=300
# Optional global read cap:
# KEYSERVER_RATE_LIMIT_READS_GLOBAL=50000

# Optional closed-registry auth (Bearer token on POST submit/revoke only):
# Recommended when open self-registration spam is an unacceptable risk.
# KEYSERVER_MUTATION_AUTH_SECRET=change-me-min-16-chars

# OpenPGP certificate structure limits (SKS-poisoning guards):
# KEYSERVER_MAX_KEY_UPLOAD_BYTES=131072
# KEYSERVER_MAX_CERT_USERIDS=16
# KEYSERVER_MAX_CERT_KEYS=32
# KEYSERVER_MAX_UID_SELF_SIGNATURES=32

# -------------------------------------------------------------------
# Replication (disabled by default; configure via config.toml instead)
# Set FULLA_CONFIG to a TOML file path. See config.toml.example and docs/REPLICATION.md
# for [replication.mesh], [replication.litestream], and [replication.ssh].
# Example: FULLA_CONFIG=/etc/fulla/config.toml
# -------------------------------------------------------------------
# FULLA_CONFIG=/etc/fulla/config.toml